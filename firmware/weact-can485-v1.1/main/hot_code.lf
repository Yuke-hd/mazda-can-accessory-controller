# Place the per-frame telemetry and CAN receive functions in IRAM.
#
# These functions run for every received CAN frame. Executing them from IRAM
# keeps them out of the shared flash cache (see hot_rodata.lf), so the
# per-frame cost no longer depends on how the linker happens to lay out flash.
#
# Entries are exact mangled symbol names. ldgen symbol entries cannot contain
# the `$` of GCC clone suffixes (`.isra`, `.constprop`, `.part`), so the
# firmware CMakeLists.txt compiles mazda_telemetry with -fno-ipa-sra
# -fno-ipa-cp-clone -fno-partial-inlining -fno-ipa-cp to keep these functions
# clone-free.
#
# ldgen silently ignores an entry whose symbol no longer exists. The
# tools/check_iram_placement.py POST_BUILD step fails the firmware build if
# any symbol listed here is missing from the ELF or outside .iram0.text.
# To update this list when the hot functions change, follow
# docs/development/flash-cache-layout.md.

[mapping:hot_code_mazda_telemetry]
archive: libmazda_telemetry.a
entries:
    vehicle_telemetry:_ZN5mazda8internal23VehicleTelemetryService14on_diagnosticsERKN17vehicle_telemetry20TransportDiagnosticsE (noflash)
    vehicle_telemetry:_ZN5mazda8internal23VehicleTelemetryService15publish_currentEb (noflash)
    vehicle_telemetry:_ZN5mazda8internal23VehicleTelemetryService21publish_notificationsERKNS_12VehicleStateERKNS_11DiagnosticsEySt8optionalImEbb (noflash)
    vehicle_telemetry:_ZN5mazda8internal23VehicleTelemetryService25service_due_notificationsEy (noflash)
    vehicle_telemetry:_ZN5mazda8internal23VehicleTelemetryService31publish_notification_descriptorINS_10ActualGearELt2EEEvRKNS_12VehicleStateERKNS_11DiagnosticsEyRKNS0_22NotificationDescriptorIT_XT0_EEE (noflash)
    vehicle_telemetry:_ZN5mazda8internal23VehicleTelemetryService31publish_notification_descriptorINS_16SelectorPositionELt1EEEvRKNS_12VehicleStateERKNS_11DiagnosticsEyRKNS0_22NotificationDescriptorIT_XT0_EEE (noflash)
    vehicle_telemetry:_ZN5mazda8internal23VehicleTelemetryService31publish_notification_descriptorINS_18FrontWiperPositionELt16EEEvRKNS_12VehicleStateERKNS_11DiagnosticsEyRKNS0_22NotificationDescriptorIT_XT0_EEE (noflash)
    vehicle_telemetry:_ZN5mazda8internal23VehicleTelemetryService31publish_notification_descriptorINS_9TurnStateELt3EEEvRKNS_12VehicleStateERKNS_11DiagnosticsEyRKNS0_22NotificationDescriptorIT_XT0_EEE (noflash)
    vehicle_telemetry:_ZN5mazda8internal23VehicleTelemetryService31publish_notification_descriptorIbLt10EEEvRKNS_12VehicleStateERKNS_11DiagnosticsEyRKNS0_22NotificationDescriptorIT_XT0_EEE (noflash)
