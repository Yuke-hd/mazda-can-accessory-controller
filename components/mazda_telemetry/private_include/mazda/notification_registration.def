// Intentionally included multiple times with MAZDA_NOTIFICATION_REGISTRATION defined.
// Keep order and channel IDs stable: tuple traversal order is part of the private
// dispatch behavior. The final row is a host-only fixed extension seam.

MAZDA_NOTIFICATION_REGISTRATION(SelectorNotificationChannel, SelectorPosition,
                                kSelectorNotificationChannel, 1, selector_channel_,
                                signal_ids::kSelectorPosition, "selector_position",
                                selector_position, candidate::kGearId,
                                candidate::kSelectorDefinition.confidence)
MAZDA_NOTIFICATION_REGISTRATION(ActualGearNotificationChannel, ActualGear,
                                kActualGearNotificationChannel, 2, actual_gear_channel_,
                                signal_ids::kActualGear, "actual_gear", actual_gear,
                                candidate::kGearId, candidate::kActualGearDefinition.confidence)
